                            Open admin panel
                            <ArrowRight class="size-4 rtl:rotate-180" />
                        </a>
                        <a
                            href="https://laravilt.com/docs"
                            target="_blank"
                            rel="noopener"
                            class="inline-flex h-10 items-center gap-2 rounded-md border border-line px-5 transition-colors hover:bg-accent"
                        >
                            <BookOpen class="size-4" />
