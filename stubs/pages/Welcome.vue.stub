                    >
                        Admin
                    </a>
                    <template v-else>
                        <a
                            :href="loginUrl"
                            class="inline-flex h-9 items-center rounded-md px-3 transition-colors hover:bg-accent"
                        >
                            Log in
                        </a>
                        <a
                            :href="registerUrl"
                            class="inline-flex h-9 items-center rounded-md border border-line px-4 transition-colors hover:bg-accent"
                        >
                            Register
                        </a>
                    </template>
                </nav>
            </header>

            <div class="stripe-divider" />

            <main class="flex flex-col">
                <!-- Hero -->
                <section
                    class="screen-line-top screen-line-bottom flex flex-col items-center px-6 py-16 text-center sm:py-24"
                >
                    <AppLogoIcon class="size-20 sm:size-24" />
                    <h1 class="mt-6 text-5xl font-semibold tracking-tight sm:text-6xl">
                        Laravilt
                    </h1>
                    <p class="mt-4 max-w-xl text-lg text-balance text-muted-foreground">
                        Elegant admin panels for Laravel, built with Inertia.
                    </p>
                    <div
                        class="mt-8 flex flex-wrap items-center justify-center gap-3 text-sm font-medium"
                    >
                        <a
                            :href="adminUrl"
