                        </a>
                    </div>
                </section>

                <div class="stripe-divider" />

                <!-- Features -->
                <section class="screen-line-top screen-line-bottom">
                    <div
                        class="screen-line-bottom flex items-center justify-between gap-4 px-6 py-4"
                    >
                        <h2 class="text-sm font-medium">Everything a panel needs</h2>
                        <span class="font-mono text-xs text-muted-foreground">laravilt/*</span>
                    </div>
                    <div class="overflow-hidden">
                        <ul class="-me-px -mb-px grid sm:grid-cols-2 lg:grid-cols-4">
                            <li
                                v-for="(feature, index) in features"
                                :key="feature.title"
                                class="flex flex-col gap-3 border-e border-b border-line p-6"
                            >
                                <div class="flex items-center justify-between">
                                    <component :is="feature.icon" class="size-5 text-brand-accent" />
                                    <span class="font-mono text-xs text-muted-foreground">
                                        {{ String(index + 1).padStart(2, '0') }}
                                    </span>
                                </div>
                                <h3 class="font-medium">{{ feature.title }}</h3>
                                <p class="text-sm text-muted-foreground">
                                    {{ feature.description }}
                                </p>
                            </li>
                        </ul>
                    </div>
                </section>

                <div class="stripe-divider" />
            </main>

            <!-- Footer -->
            <footer
                class="screen-line-top screen-line-bottom flex flex-col items-center justify-between gap-3 px-6 py-5 text-sm text-muted-foreground sm:flex-row"
            >
                <div class="flex items-center gap-2">
                    <AppLogoIcon class="size-5" />
                    <span v-if="laravelVersion && phpVersion">
                        Laravel v{{ laravelVersion }} (PHP v{{ phpVersion }})
                    </span>
                    <span v-else>Laravilt</span>
                </div>
                <div class="flex items-center gap-4">
                    <a
                        href="https://laravilt.com/docs"
                        target="_blank"
                        rel="noopener"
                        class="transition-colors hover:text-foreground"
